ORDER BY scheduled_time DESC;


ALTER TASK uber_enterprise_db.bronze.t_load_gold RESUME;
ALTER TASK uber_enterprise_db.bronze.t_transform_silver RESUME;
ALTER TASK uber_enterprise_db.bronze.t_load_bronze RESUME;


ALTER WAREHOUSE enterprise_wh RESUME;


EXECUTE TASK uber_enterprise_db.bronze.t_load_bronze;



-- 1. Suspend the root task first
ALTER TASK uber_enterprise_db.bronze.t_load_bronze SUSPEND;

-- 2. Suspend the child task
ALTER TASK uber_enterprise_db.bronze.t_transform_silver SUSPEND;

-- 3. Suspend the grandchild task
ALTER TASK uber_enterprise_db.bronze.t_load_gold SUSPEND;


